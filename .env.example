# =============================================================================
# ClaimDesk - THE single configuration file (app + deploy scripts)
# =============================================================================
# HOW TO USE
#   cp .env.example .env      # then edit the values marked  <-- EDIT
#
# WHO READS THIS FILE
#   * The Python app (claimdesk/settings.py) when you run locally.
#   * Every deploy script: deploy/00_variables.sh does `source .env`.
#   * Cloud Run: deploy/05_deploy_cloud_run.sh turns the RUNTIME section below
#     into a YAML file and passes it with `--env-vars-file`, so the service
#     gets exactly the same values you tested with locally.
#   `.env` is git-ignored and never baked into the container image.
#
# RULES FOR THIS FILE
#   * KEY=value, one per line, no spaces around "=".
#   * Comments on their own lines only (no trailing "# ..." after a value).
#   * No secrets: there is NO API key anywhere. Google calls use Application
#     Default Credentials (your gcloud login locally, the service account on
#     Cloud Run).
# =============================================================================


# #############################################################################
# RUNTIME SECTION - sent to Cloud Run (keys starting with GOOGLE_, LIVE_MODEL_,
# CLAIMDESK_). Anything here is visible in the Cloud Run console, so never put
# secrets here.
# #############################################################################

# --- Google Cloud project ----------------------------------------------------
# <-- EDIT: your project id
GOOGLE_CLOUD_PROJECT=your-project-id
# All GCP resources live here: Cloud Run, Artifact Registry, Cloud Storage,
# Firestore and BigQuery.
CLAIMDESK_REGION=us-central1

# --- Gemini models on Vertex AI (names are FIXED - do not change) ------------
# "global" = Google routes each request to wherever capacity exists
# (best availability, fewest 429 errors).
GOOGLE_CLOUD_LOCATION=global
LIVE_MODEL_LOCATION=global
# If your project cannot open a Live session on "global", the app retries ONCE
# here. Keep it equal to CLAIMDESK_REGION. Check with scripts/check_models.py.
LIVE_MODEL_FALLBACK_LOCATION=us-central1
CLAIMDESK_LIVE_MODEL=gemini-3.8-live
CLAIMDESK_REASONING_MODEL=gemini-3.8-flash
CLAIMDESK_SKETCH_MODEL=gemini-3.1-flash-image
CLAIMDESK_VOICE=Kore

# --- BigQuery (same region as everything else) --------------------------------
CLAIMDESK_BQ_DATASET=claimdesk
CLAIMDESK_BQ_LOCATION=us-central1

# --- Cloud Storage + Firestore --------------------------------------------------
# <-- EDIT: globally unique bucket name (private; public access prevention on)
CLAIMDESK_GCS_BUCKET=your-project-id-claimdesk-evidence
CLAIMDESK_FIRESTORE_DATABASE=(default)
CLAIMDESK_FIRESTORE_COLLECTION=intakes

# --- Business scope --------------------------------------------------------------
# Two-letter state codes the flood desk serves. Used by the data pipeline
# (which FEMA/NOAA rows to load), the agent's instructions and the UI.
CLAIMDESK_SUPPORTED_STATES=CO,TX,FL,LA,NC

# --- Brand: a FICTITIOUS insurance company ------------------------------------
# "Demo Tideline": a tide line is the high-water mark a flood leaves on a wall.
# The "Demo" prefix makes it obvious to anyone who sees the app that it is not
# a real insurer. Internal code names (Python package, BigQuery dataset,
# Firestore collection, labels) stay "claimdesk"; only what people see changes.
CLAIMDESK_BRAND_NAME=Demo Tideline
CLAIMDESK_BRAND_TAGLINE=Flood claims, handled with care.
# The voice agent's first name ("Hi, this is Maya from Demo Tideline flood claims...").
CLAIMDESK_AGENT_NAME=Maya
# 555-01xx numbers are reserved for fiction - this rings nowhere.
CLAIMDESK_CLAIMS_PHONE=1-800-555-0142

# --- Limits --------------------------------------------------------------------
# Active intakes held by ONE Cloud Run instance.
CLAIMDESK_MAX_SESSIONS=32
# Evidence photos per intake.
CLAIMDESK_MAX_PHOTOS=20
# Largest single WebSocket message from the browser (bytes).
CLAIMDESK_MAX_MESSAGE_BYTES=800000
# A live voice session is ended after this many minutes (cost + safety cap).
CLAIMDESK_LIVE_SESSION_MINUTES=20
# An untouched intake expires after this many minutes (Firestore TTL too).
CLAIMDESK_IDLE_EXPIRY_MINUTES=30
# Camera frames per second sent to Gemini Live (biggest cost lever; 0.5 halves it).
CLAIMDESK_CAMERA_FPS=1
# A frame older than this cannot be captured as evidence (seconds).
CLAIMDESK_FRAME_MAX_AGE_SECONDS=12

# --- Behaviour switches ---------------------------------------------------------
# "memory" = everything in RAM (first local run, no cloud resources needed)
# "gcp"    = Firestore + Cloud Storage + BigQuery (what Cloud Run uses)
CLAIMDESK_STORAGE_BACKEND=memory
# Send OpenTelemetry spans to Cloud Trace (needs roles/cloudtrace.agent).
CLAIMDESK_ENABLE_CLOUD_TRACE=false
# NOAA storm-event corroboration query (our BigQuery copy of NOAA data).
CLAIMDESK_ENABLE_WEATHER_CHECK=true
CLAIMDESK_LOG_LEVEL=INFO
# Timezone (IANA name) used for "today"/"yesterday" when reading the claimant's
# dates and for the timing rules. Cloud Run's clock is UTC, which is already
# "tomorrow" on a US evening. America/Chicago (Central) is within one hour of
# every supported state. Unknown names fall back to UTC with a log warning.
CLAIMDESK_TIMEZONE=America/Chicago

# --- IAP-signed JWT verification inside the app (defence in depth) -----------
# Leave EMPTY. deploy/05_deploy_cloud_run.sh always sets it on the service to
# /projects/<PROJECT_NUMBER>/locations/<REGION>/services/<SERVICE_NAME>
# (the documented audience for IAP on Cloud Run) and ignores this value.
# On Cloud Run the app refuses requests without a valid IAP JWT; locally
# (not on Cloud Run) it is not checked and the user is "local-dev".
CLAIMDESK_IAP_AUDIENCE=
# Extra origins allowed for non-GET requests (comma-separated). Usually empty.
CLAIMDESK_ALLOWED_ORIGINS=

# --- Accuracy: domain knowledge from the Agent Skill ---------------------------
# skills/nfip-flood-intake (flood definition, water sources, documents, safety,
# approved language, worked examples) is added to every prompt. Set to false
# only to measure its effect in evals ("before" vs "after").
CLAIMDESK_USE_SKILL=true

# --- Accuracy: grounding on FEMA NFIP documents with Vertex AI Search ----------
# REGION EXCEPTION: Vertex AI Search data stores only exist in the "global",
# "us" or "eu" multi-regions. We use "us" so the index stays in the United
# States. It is the ONLY resource not in us-central1 (see docs/grounding.md).
CLAIMDESK_SEARCH_LOCATION=us
# The engine ("app") created by deploy/03b_vertex_ai_search.sh.
CLAIMDESK_SEARCH_ENGINE_ID=fema-nfip-engine
# Turn the lookup_flood_guidance voice tool on ONLY after 03b has finished
# and its test query returned results. false = the agent still works, it just
# answers general questions from the built-in skill knowledge only.
CLAIMDESK_ENABLE_GUIDANCE_SEARCH=false


# #############################################################################
# DEPLOY-ONLY SECTION - used by deploy/*.sh, NOT sent to Cloud Run
# (keys start with DEPLOY_).
# #############################################################################

# <-- EDIT: the ONLY Google account allowed through IAP
DEPLOY_IAP_USER_EMAIL=you@example.com
# Cloud Run service, its service account and the image repository. Named after
# the brand so they are easy to spot in the Console.
DEPLOY_SERVICE_NAME=demo-tideline
DEPLOY_RUN_SA_NAME=demo-tideline-run
DEPLOY_AR_REPO=demo-tideline
# Vertex AI Search data store that holds the FEMA documents (deploy/03b).
DEPLOY_SEARCH_DATA_STORE_ID=fema-nfip-docs
# Cloud Run sizing for ONE user (see docs/scaling_to_1000_users.md).
DEPLOY_MIN_INSTANCES=0
DEPLOY_MAX_INSTANCES=1
DEPLOY_CONCURRENCY=20
DEPLOY_CPU=1
DEPLOY_MEMORY=2Gi
DEPLOY_TIMEOUT_SECONDS=3600
# Monthly budget alert amount in USD (deploy/07).
DEPLOY_BUDGET_USD=25
